generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id                  Int      @id @default(autoincrement())
  title               String
  title_en            String?
  title_it            String?
  title_es            String?
  description         String
  description_en      String?
  description_it      String?
  description_es      String?
  longDescription     String?
  longDescription_en  String?
  longDescription_it  String?
  longDescription_es  String?
  highlights          String[]
  highlights_en       String[]
  highlights_it       String[]
  highlights_es       String[]
  stack               String[]
  imageKey            String?
  imageUrl            String?
  liveUrl             String?
  githubUrl           String?
  featured            Boolean  @default(false)
  visible             Boolean  @default(true)
  order               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Section {
  id        Int      @id @default(autoincrement())
  slot      String   @unique
  imageKey  String?
  imageUrl  String?
  text      String?
  text_en   String?
  text_it   String?
  text_es   String?
  updatedAt DateTime @updatedAt
}
