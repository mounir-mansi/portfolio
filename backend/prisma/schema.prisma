generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  activity  String?
  company   String?
  message   String?
  source    String   @default("contact")
  // Brief facultatif complété après l'envoi de la demande (formulaire en étapes)
  pack           String?
  // Identifiants (aléatoires) des fichiers importés ; le fichier est dans brief/<id du message>/<identifiant>
  menuFiles      String[]
  logoFile       String?
  pages          String[]
  pagesAutre     String?
  theme          String?
  couleurs       String?
  police         String?
  aLogo          Boolean?
  echeance       String?
  creneau        String?
  briefDone      Boolean   @default(false)
  // Empreinte (sha256) du jeton remis au visiteur : le jeton lui-même n'est jamais stocké
  briefTokenHash String?   @unique
  briefExpiresAt DateTime?
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id                  Int      @id @default(autoincrement())
  title               String
  title_en            String?
  title_it            String?
  title_es            String?
  description         String
  description_en      String?
  description_it      String?
  description_es      String?
  longDescription     String?
  longDescription_en  String?
  longDescription_it  String?
  longDescription_es  String?
  highlights          String[]
  highlights_en       String[]
  highlights_it       String[]
  highlights_es       String[]
  stack               String[]
  imageKey            String?
  imageUrl            String?
  liveUrl             String?
  githubUrl           String?
  featured            Boolean  @default(false)
  visible             Boolean  @default(true)
  order               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Section {
  id        Int      @id @default(autoincrement())
  slot      String   @unique
  imageKey  String?
  imageUrl  String?
  text      String?
  text_en   String?
  text_it   String?
  text_es   String?
  updatedAt DateTime @updatedAt
}
